# Copy this file to .env and fill in your bot password credentials.
# Create one at https://wiki.fosscell.org/Special:BotPasswords
#
# The launcher (scripts/start-mcp.js) reads these and writes them into
# config.json automatically, so .env is the only file you need to edit
# when rotating credentials.

BOT_USERNAME=YourUsername@mcp-bot
BOT_PASSWORD=
